# SQLite for local/dev. Use Postgres URL in production (postgresql://...)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-secret"
AUTH_TRUST_HOST="true"
# NEXTAUTH_URL is set automatically on Vercel; set locally if needed:
# NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Never seed fictional marketplace data in production.
# Only when SEED_DEMO=true will demo listings be created (dev/staging only).
SEED_DEMO="false"

# Bootstrap admin (created by seed script)
ADMIN_EMAIL="admin@fleetmarket.sa"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_NAME="FleetMarket Admin"
ADMIN_PHONE="0800000000"

# POPIA policy version shown at registration
POPIA_POLICY_VERSION="2026-11-01"
DATA_RETENTION_ENQUIRY_DAYS="365"

# Email delivery for enquiry / request notifications.
# If SMTP is unset, notifications are logged to NotificationLog + server console (dev fallback).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FleetMarket SA <noreply@fleetmarket.sa>"
